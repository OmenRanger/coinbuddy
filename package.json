{
  "name": "coinbuddy",
  "private": true,
  "version": "0.1.0",
  "description": "A warm, local-first coin collection companion built for simple inventory, archive records, value ranges, education, and reports.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs dist",
    "lint": "node scripts/lint.mjs",
    "test": "node --test src/tests/*.test.mjs",
    "test:browser": "node scripts/browser-test.mjs",
    "build": "node scripts/build.mjs",
    "react:dev": "vite",
    "react:build": "tsc -b && vite build",
    "react:test": "vitest --config vitest.config.ts run"
  },
  "keywords": [
    "coins",
    "collection",
    "pwa",
    "archive",
    "local-first"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vitest": "^2.1.5"
  }
}
